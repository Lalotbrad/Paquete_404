--- !u!1001 &736023897
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 4355799243717726185, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: m_SortingOrder
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: BotonA
      value: 
      objectReference: {fileID: 420214317}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: BotonB
      value: 
      objectReference: {fileID: 40721096}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: BotonC
      value: 
      objectReference: {fileID: 97280073}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: PanelDialogo
      value: 
      objectReference: {fileID: 977294240}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: TextoErrores
      value: 
      objectReference: {fileID: 1128807322}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: TextoAciertos
      value: 
      objectReference: {fileID: 723247711}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: TextoPregunta
      value: 
      objectReference: {fileID: 1336071555}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[0].Dialogo
      value: "\"\xA1Ya s\xE1banas , rey! \xA1Celular y cartera, r\xE1pido!\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[1].Dialogo
      value: "\"A ver, desbloqu\xE9ame esta madre y qu\xEDtale el iCloud.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[2].Dialogo
      value: "\"\xBFQu\xE9 pedo? \xA1Nom\xE1s traes 50 varos y una tarjeta del cami\xF3n!\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[3].Dialogo
      value: "\"\xA1Mu\xE9vete, g\xFCey, no tengo todo el d\xEDa! \xA1Suelta los
        tenis tambi\xE9n!\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[4].Dialogo
      value: "\"\xD3rale, date la vuelta, no voltees y ponte a caminar.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[0].RespuestaA
      value: "\"Toma, ah\xED est\xE1 todo, nom\xE1s no me hagas nada.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[0].RespuestaB
      value: "\"\xBFPor qu\xE9 me dices rey? Ni q fuera joto.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[0].RespuestaC
      value: "\"Igual que ella, llegas, me hablas bonito y nom\xE1s para llevarte
        lo que me queda y luego desaparecer.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[1].RespuestaA
      value: "\"Buscas algo que nunca tuvo, solo haces el sufrimiento m\xE1s largo
        porque no puedes solo irte.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[1].RespuestaB
      value: "\"La contrase\xF1a es 1234, ten.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[1].RespuestaC
      value: '"Es Android, jefe, no tiene iCloud."'
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[2].RespuestaA
      value: "\"Es que todav\xEDa no caga el \xE1guila.\" "
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[2].RespuestaB
      value: "\"Ya vas a empezar a juzgarme por mi estabilidad financiera igual que
        mi pap\xE1, \xBFverdad? Perd\xF3n por no ser el hijo exitoso que quer\xEDas,
        \xA1estoy haciendo lo que puedo!\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[2].RespuestaC
      value: '"Si quieres te paso los 50 y me dejas la tarjeta para llegar a mi casa."'
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[3].RespuestaA
      value: "\"Esp\xE9rate, es que tienen doble nudo.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[3].RespuestaB
      value: '"Ya voy, ya voy, no te enojes."'
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[3].RespuestaC
      value: "\"Qu\xE9 f\xE1cil es presionarme cuando sabes lo que me cuesta desprenderme
        de lo que tuve.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[4].RespuestaA
      value: "\"Vete igual ya me acostumbr\xE9 a perder todo lo que tengo\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[4].RespuestaB
      value: "\"S\xED, s\xED, yo no vi nada, t\xFA dale.\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[4].RespuestaC
      value: "\"\xBFPara qu\xE9 lado camino o qu\xE9?\""
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[0].RespuestaCorrecta
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[1].RespuestaCorrecta
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
      propertyPath: Preguntas.Array.data[2].RespuestaCorrecta
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4935341353432580815, guid: 908397d4577981046a3a6d479bc4a9c0, type: 3}
